# Plantilla de variables de entorno. Este archivo SÍ se versiona: no pongas
# credenciales reales aquí.
#
# Copia este archivo según el entorno (ver docs/ENTORNOS.md):
#   .env.development.local  -> lo usa `npm run dev`      (proyecto Supabase de desarrollo)
#   .env.production.local   -> lo usa `npm run build`    (proyecto Supabase de producción)
#   .env.staging.local      -> lo usa `npm run build:staging` (opcional)
#
# NO uses un `.env` a secas: Vite lo carga en TODOS los modos.

# A qué entorno pertenecen estas credenciales. Debe coincidir con el modo en
# que corre la app (development | staging | production). Si no coincide, la
# app se niega a conectarse a Supabase.
VITE_APP_ENV=development

# URL del proyecto Supabase de ESTE entorno (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima del proyecto de ESTE entorno (Dashboard > Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-key
