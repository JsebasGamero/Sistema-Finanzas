# Supabase Configuration
# Copia este archivo como .env y reemplaza los valores.
# IMPORTANTE: este archivo se versiona en git. No pongas credenciales reales aquí.

# URL de tu proyecto Supabase (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (Dashboard > Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-key
